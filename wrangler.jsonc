{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ayabriksine-portfolio",
  "compatibility_date": "2026-10-19",
  "assets": {
    "directory": ".",
    "not_found_handling": "404-page",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/portfolio-chat"
    ]
  },
  "main": "worker/portfolio-chat.mjs",
  "ai": {
    "binding": "AI"
  },
  "ratelimits": [
    {
      "name": "CHAT_LIMIT",
      "namespace_id": "1",
      "simple": {
        "limit": 8,
        "period": 60
      }
    }
  ]
}
